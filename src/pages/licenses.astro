---
import { readFile } from "node:fs/promises";
import { join } from "node:path";
import Outline from "@/components/Outline.astro";
import PageHead from "@/components/PageHead.astro";
import Layout from "@/layouts/Layout.astro";
import { approvedDir, loadApprovedVersions } from "@/lib/catalog";
import { licenseName } from "@/lib/browse";
import { licenseTerms } from "@/lib/license";
import type { CatalogSkill } from "@/lib/types";
import { charterAnchor } from "@/lib/skill-page";

// Every approved version carries its own LICENSE. Most skills share one with others from the same repository, so
// the page groups them: by license, then by the exact text (one per crafter, usually), each text shown once.
type Charter = { repo: string; text: string; skills: Map<string, CatalogSkill[]> };
const byLicense = new Map<string, Map<string, Charter>>();
for (const skill of [...(await loadApprovedVersions()).values()].flat()) {
  const text = await readFile(join(approvedDir(skill.id, skill.version), "LICENSE"), "utf8");
  const texts = byLicense.get(skill.license) ?? new Map<string, Charter>();
  byLicense.set(skill.license, texts);
  const key = `${skill.repo}\n${text}`;
  const charter = texts.get(key) ?? { repo: skill.repo, text, skills: new Map() };
  texts.set(key, charter);
  charter.skills.set(skill.id, [...(charter.skills.get(skill.id) ?? []), skill]);
}
const count = (charters: Charter[]) => charters.reduce((n, c) => n + c.skills.size, 0);
const licenses = [...byLicense]
  .map(([spdx, texts]) => ({ spdx, charters: [...texts.values()].sort((a, b) => a.repo.localeCompare(b.repo)) }))
  .sort((a, b) => count(b.charters) - count(a.charters) || a.spdx.localeCompare(b.spdx));
const skills = licenses.reduce((n, l) => n + count(l.charters), 0);
const crafters = new Set(licenses.flatMap((l) => l.charters.map((c) => c.repo.split("/")[0]))).size;
const anchored = new Set<string>();

// LicenseRef-* ids are the market's own names for source-available licenses the market knows by their exact text,
// not SPDX ids: show a readable name, with the raw id kept small and in mono next to it.
const isRef = (spdx: string) => spdx.startsWith("LicenseRef-");
---

<Layout crumbs={[{ label: "Charters" }]} title="Charters" description="The license of every skill in the market, grouped by license and crafter.">
  <div class="with-outline">
  <div class="stack stack-xl">
    <PageHead title="Charters">
      <p class="lede">
        Every skill carries its crafter's charter (license), unaltered: {skills} skill{skills === 1 ? "" : "s"} from{" "}
        {crafters} crafter{crafters === 1 ? "" : "s"}, under {licenses.length} license{licenses.length === 1 ? "" : "s"}. Look up a
        skill or crafter to see what you may do with it. The marktplatz code itself is{" "}
        <a href="https://github.com/marktplatz-dev/marktplatz-dev/blob/main/LICENSE">MIT-licensed</a>.
      </p>
      <Fragment slot="meta">
        {
          licenses.map((l) => (
            <a class="badge" href={`#${charterAnchor(l.spdx)}`} data-license-badge={l.spdx}>
              {isRef(l.spdx) ? licenseName(l.spdx) : l.spdx} · {count(l.charters)}
            </a>
          ))
        }
      </Fragment>
    </PageHead>

    <div class="toolbar">
      <label class="search">
        <span class="sr-only">Find a skill or crafter</span>
        <svg class="search-icon" viewBox="0 0 8 8" aria-hidden="true" shape-rendering="crispEdges">
          <path d="M1 0h3v1H1zM0 1h1v3H0zM4 1h1v3H4zM1 4h3v1H1zM4 5h1v1H4zM5 6h1v1H5zM6 7h1v1H6z" fill="currentColor"></path>
        </svg>
        <input type="search" placeholder="Find a skill or crafter…" autocomplete="off" spellcheck="false" data-charter-find />
      </label>
    </div>

    <div class="stack stack-lg">
      {
        licenses.map((l) => (
          <section class="stack stack-sm" id={charterAnchor(l.spdx)} data-license={l.spdx}>
            <h2 class="section-title">
              {isRef(l.spdx) ? licenseName(l.spdx) : l.spdx}
              {isRef(l.spdx) && <span class="mono">{l.spdx}</span>}
              <span>
                {count(l.charters)} skill{count(l.charters) === 1 ? "" : "s"} from {l.charters.length} crafter{l.charters.length === 1 ? "" : "s"}
                {!licenseTerms(l.spdx) && (
                  <>
                    {" "}· <a href={`https://spdx.org/licenses/${l.spdx}.html`}>what it allows</a>
                  </>
                )}
              </span>
            </h2>
            {licenseTerms(l.spdx) && <p class="note note-warn">{licenseTerms(l.spdx)}</p>}
            <ul class="panel panel-flush charter-list">
              {l.charters.map((c, i) => {
                const textId = `${charterAnchor(l.spdx)}-text-${i}`;
                return (
                  <li class="charter-row" data-charter={`${c.repo} ${[...c.skills.keys()].join(" ")}`.toLowerCase()}>
                    <a class="charter-repo" href={`https://github.com/${c.repo}`}>
                      {c.repo}
                    </a>
                    <p class="charter-skills">
                      {[...c.skills].map(([id, versions], j) => {
                        const first = !anchored.has(id);
                        anchored.add(id);
                        return (
                          <>
                            {j > 0 && <span aria-hidden="true"> · </span>}
                            <a id={first ? `skill-${id}` : undefined} href={`/skills/${id}`} title={versions.map((v) => v.version).join(", ")}>
                              {id}
                            </a>
                          </>
                        );
                      })}
                    </p>
                    <button type="button" class="btn btn-ghost btn-sm" aria-expanded="false" aria-controls={textId} data-charter-toggle>
                      Text
                    </button>
                    <pre class="well charter-text" id={textId} hidden>{c.text}</pre>
                  </li>
                );
              })}
            </ul>
          </section>
        ))
      }
    </div>
    <p class="muted" data-charter-none hidden>No skill or crafter by that name.</p>
  </div>
  <aside class="outline-side"><Outline /></aside>
  </div>
</Layout>

<script>
  // Each crafter's license text opens under its row.
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-charter-toggle]")) {
    button.addEventListener("click", () => {
      const text = document.getElementById(button.getAttribute("aria-controls")!)!;
      const open = text.hidden;
      text.hidden = !open;
      button.setAttribute("aria-expanded", String(open));
      button.textContent = open ? "Hide" : "Text";
    });
  }

  // Narrow the page to the crafters and skills matching every word typed; the license badges at the top follow along.
  const input = document.querySelector<HTMLInputElement>("[data-charter-find]")!;
  input.addEventListener("input", () => {
    const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const section of document.querySelectorAll<HTMLElement>("[data-license]")) {
      let any = false;
      for (const charter of section.querySelectorAll<HTMLElement>("[data-charter]")) {
        const match = words.every((w) => charter.dataset.charter!.includes(w));
        charter.hidden = !match;
        any ||= match;
      }
      section.hidden = !any;
      const badge = document.querySelector<HTMLElement>(`[data-license-badge="${section.dataset.license}"]`);
      if (badge) badge.hidden = !any;
      if (any) shown++;
    }
    document.querySelector<HTMLElement>("[data-charter-none]")!.hidden = shown > 0;
  });
</script>
